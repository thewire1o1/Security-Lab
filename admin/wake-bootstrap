#!/usr/bin/env bash
set -Eeuo pipefail

REPO="${GITHUB_REPOSITORY:-thewire1o1/Security-Lab}"
SECRET_NAME="DPSR_CODESPACES_TOKEN"

if ! command -v gh >/dev/null 2>&1; then
  printf 'DPSR wake controller credential unavailable: gh is not installed.\n' >&2
  exit 1
fi

TOKEN=""
SOURCE=""

try_token() {
  local candidate="$1"
  local source="$2"
  [ -n "$candidate" ] || return 1
  if GH_TOKEN="$candidate" timeout 15 gh api '/user/codespaces?per_page=1' >/dev/null 2>&1; then
    TOKEN="$candidate"
    SOURCE="$source"
    return 0
  fi
  return 1
}

stored="$(env -u GH_TOKEN -u GITHUB_TOKEN gh auth token --hostname github.com 2>/dev/null || true)"
try_token "$stored" 'stored gh credential' || \
  try_token "${GH_TOKEN:-}" 'GH_TOKEN' || \
  try_token "${GITHUB_TOKEN:-}" 'GITHUB_TOKEN' || true

if [ -z "$TOKEN" ]; then
  printf 'DPSR wake controller credential unavailable: no Codespaces-capable GitHub credential found.\n' >&2
  exit 1
fi

if printf '%s' "$TOKEN" | GH_TOKEN="$TOKEN" timeout 20 gh secret set "$SECRET_NAME" --repo "$REPO" >/dev/null 2>&1; then
  printf 'DPSR wake controller credential ready via %s.\n' "$SOURCE"
  exit 0
fi

printf 'DPSR wake controller credential has Codespaces access but cannot write the repository Actions secret.\n' >&2
exit 1
