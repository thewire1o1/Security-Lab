#!/usr/bin/env bash
set -Eeuo pipefail

TOKENFILE="${SEC_BRIDGE_TOKEN_FILE:-$HOME/.config/dpsr/bridge-token}"
if [ -n "${DPSR_BRIDGE_TOKEN:-}" ]; then
  TOKEN="$DPSR_BRIDGE_TOKEN"
  SOURCE="DPSR_BRIDGE_TOKEN"
elif [ -s "$TOKENFILE" ]; then
  TOKEN="$(cat "$TOKENFILE")"
  SOURCE="$TOKENFILE"
else
  printf 'Bridge credential: fallback credential source in use.\n'
  exit 1
fi

python3 - "$TOKEN" "$SOURCE" <<'PY'
import json
import sys
import urllib.request

token, source = sys.argv[1], sys.argv[2]
request = urllib.request.Request(
    "https://api.github.com/user",
    headers={
        "Authorization": f"Bearer {token}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "dpsr-bridge-credential-status",
    },
)
with urllib.request.urlopen(request, timeout=15) as response:
    payload = json.loads(response.read().decode("utf-8"))
    scopes = sorted(s.strip() for s in (response.headers.get("X-OAuth-Scopes") or "").split(",") if s.strip())
print(f"Bridge credential: dedicated")
print(f"Source: {source}")
print(f"Account: {payload.get('login', '')}")
print("Scopes: " + ", ".join(scopes))
print("Codespaces scope: " + ("present" if "codespace" in scopes else "absent"))
PY
