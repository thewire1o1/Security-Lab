#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p "$ROOT/reports"
nohup bash -c '
  sleep 3
  bash "$1/bin/remote-agent" stop || true
  sleep 1
  bash "$1/bin/remote-agent" start || true
' _ "$ROOT" >>"$ROOT/reports/remote-agent-refresh.log" 2>&1 </dev/null &
printf 'Remote agent reload scheduled.\n'
