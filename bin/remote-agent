#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DISABLED="$ROOT/.remote-agent.disabled"
cd "$ROOT"

case "${1:-}" in
  start)
    rm -f "$DISABLED"
    python3 -m security_lab.remote_agent_ext start
    rc=$?
    bash "$ROOT/admin/control-plane-supervisor" start || true
    exit "$rc"
    ;;
  stop)
    touch "$DISABLED"
    exec python3 -m security_lab.remote_agent_ext stop
    ;;
  *)
    exec python3 -m security_lab.remote_agent_ext "$@"
    ;;
esac
