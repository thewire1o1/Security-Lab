#!/usr/bin/env bash
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="/usr/local/go/bin:$HOME/go/bin:$HOME/.local/bin:$ROOT/bin:$PATH"

printf 'Security Lab doctor\n\n'

for cmd in sec docker nmap masscan sqlmap nikto hydra john pdtm nuclei httpx subfinder naabu dnsx katana ffuf waybackurls assetfinder gau semgrep pip-audit bandit gitleaks trivy shellcheck jq; do
  if command -v "$cmd" >/dev/null 2>&1; then
    v="$($cmd --version 2>/dev/null | head -n 1 || true)"
    [ -z "$v" ] && v="installed"
    printf '[OK] %-20s %s\n' "$cmd" "$v"
  else
    printf '[--] %-20s missing\n' "$cmd"
  fi
done

printf '\nDocker:\n'
docker info --format '  server={{.ServerVersion}} containers={{.Containers}} images={{.Images}}' 2>/dev/null || echo '  Docker daemon unavailable.'

printf '\nKali operator image:\n'
if docker image inspect ghcr.io/thewire1o1/security-lab-kali:latest >/dev/null 2>&1 || docker image inspect security-lab-kali:latest >/dev/null 2>&1; then
  echo '  [OK] available'
else
  echo '  [--] not available yet'
fi

printf '\nDefensive pipeline:\n'
for f in code-review validate-findings fuzz-run triage research defense-run review-engine; do
  if [ -f "$ROOT/bin/$f" ]; then
    printf '  [OK] %s\n' "$f"
  else
    printf '  [--] %s missing\n' "$f"
  fi
done

printf '\nLab containers:\n'
docker compose -f "$ROOT/lab/docker-compose.yml" --profile operator ps 2>/dev/null || true
