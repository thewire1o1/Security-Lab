#!/usr/bin/env bash
set -u

MODE="${1:-auto}"
THRESHOLD="${DISK_GUARD_THRESHOLD:-82}"

usage_pct() {
  df -P / | awk 'NR==2 {gsub(/%/, "", $5); print $5}'
}

show_space() {
  printf 'Disk: '
  df -h / | awk 'NR==2 {printf "%s used, %s free (%s)\n", $3, $4, $5}'
}

before="$(usage_pct 2>/dev/null || echo 0)"
show_space

if [ "$MODE" != "--force" ] && [ "${before:-0}" -lt "$THRESHOLD" ]; then
  exit 0
fi

printf '[+] Reclaiming disposable caches and Docker build data...\n'

sudo apt-get clean >/dev/null 2>&1 || true
rm -rf "$HOME/.cache/pip"/* "$HOME/.cache/go-build"/* "$HOME/.npm/_cacache"/* 2>/dev/null || true

docker container prune -f --filter 'until=24h' >/dev/null 2>&1 || true
docker image prune -f >/dev/null 2>&1 || true
docker builder prune -af --filter 'until=24h' >/dev/null 2>&1 || true

printf '[+] Cleanup complete.\n'
show_space
