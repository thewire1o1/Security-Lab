#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE=(docker compose -f "$ROOT/lab/docker-compose.yml")

usage() {
  cat <<'EOF'
Security Lab control

  sec doctor                 health check
  sec up                     start vulnerable training targets
  sec down                   stop training targets
  sec ps                     show lab containers
  sec scan                   scan the local lab
  sec dashboard              launch Mission Control on 127.0.0.1:8765
  sec gui                    alias for sec dashboard
  sec report                 generate HTML/JSON report from latest local scan
  sec defend                 run the complete defensive pipeline
  sec review                 run repository security review
  sec validate               compare current findings with prior run
  sec fuzz                   fuzz local training targets and custom harnesses
  sec triage FILE            statically triage a file
  sec research ...           manage persistent research cases
  sec engine [FILE]          run configured external review command
  sec kali-build             refresh Kali operator image
  sec kali                   open Kali operator shell
  sec clean                  reclaim disposable caches and Docker build data
  sec disk                   show disk and Docker storage usage
  sec update                 update tools and templates
  sec update --full          also refresh Kali image
  sec new NAME               create an engagement workspace
EOF
}

kali_up() {
  "${COMPOSE[@]}" --profile operator up -d kali >/dev/null
}

kali_refresh() {
  printf '%s\n' '[+] Pulling Kali operator image...'
  if "${COMPOSE[@]}" --profile operator pull kali; then
    docker builder prune -af --filter 'until=24h' >/dev/null 2>&1 || true
    return 0
  fi
  printf '%s\n' '[!] Prebuilt image unavailable; building locally.'
  "${COMPOSE[@]}" --profile operator build --pull kali
  docker builder prune -af >/dev/null 2>&1 || true
}

cmd="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$cmd" in
  help|-h|--help) usage ;;
  doctor) exec bash "$ROOT/bin/doctor" "$@" ;;
  up) exec "${COMPOSE[@]}" up -d juice-shop dvwa webgoat ;;
  down) exec "${COMPOSE[@]}" --profile operator down ;;
  ps) exec "${COMPOSE[@]}" --profile operator ps ;;
  scan) exec bash "$ROOT/bin/labscan" "$@" ;;
  dashboard|gui)
    printf '%s\n' 'Mission Control starting at http://127.0.0.1:8765'
    printf '%s\n' 'In Codespaces, open forwarded port 8765 and keep its visibility Private.'
    cd "$ROOT"
    exec python3 -m security_lab.dashboard "$@"
    ;;
  report) exec python3 "$ROOT/bin/sec-report" "$@" ;;
  defend) exec bash "$ROOT/bin/defense-run" "$@" ;;
  review) exec bash "$ROOT/bin/code-review" "$@" ;;
  validate) exec bash "$ROOT/bin/validate-findings" "$@" ;;
  fuzz) exec bash "$ROOT/bin/fuzz-run" "$@" ;;
  triage) exec bash "$ROOT/bin/triage" "$@" ;;
  research) exec bash "$ROOT/bin/research" "$@" ;;
  engine) exec bash "$ROOT/bin/review-engine" "$@" ;;
  kali-build) kali_refresh ;;
  kali)
    kali_up
    exec "${COMPOSE[@]}" --profile operator exec kali bash
    ;;
  clean) exec bash "$ROOT/bin/disk-guard" --force ;;
  disk)
    df -h /
    if command -v docker >/dev/null 2>&1; then
      printf '\n'
      docker system df || true
    fi
    ;;
  update) exec bash "$ROOT/bin/update-all" "$@" ;;
  new) exec bash "$ROOT/bin/new-engagement" "$@" ;;
  *)
    printf 'Unknown command: %s\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac
