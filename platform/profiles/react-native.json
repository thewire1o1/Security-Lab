{
  "profile": {
    "name": "react-native",
    "title": "React Native Mobile",
    "category": "mobile",
    "description": "Bare React Native application profile generated by the Community CLI with TypeScript, Android/iOS native projects, local tests/lint, Metro, and CI Android builds.",
    "runner": "local",
    "stack": ["node", "typescript", "react-native"],
    "capabilities": ["android", "ios", "testing", "metro", "ci", "release"],
    "scaffold": "react-native"
  },
  "commands": {
    "lint": {"argv": ["npm", "run", "lint"], "cwd": "app", "timeout": 900},
    "test": {"argv": ["npm", "test", "--", "--runInBand"], "cwd": "app", "timeout": 1200},
    "android-build": {"argv": ["./gradlew", "assembleDebug"], "cwd": "app/android", "timeout": 3600},
    "dev": {"argv": ["npm", "start"], "cwd": "app", "timeout": 86400}
  },
  "services": {"metro": 8081}
}
